{
  "name": "specshield-qa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-First Spec-to-Test & Playwright E2E Studio for Dev Agencies & Freelance QA Engineers",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server/index.ts",
    "smoke": "FORCE_FALLBACK=true tsx scripts/smoke.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@mastra/core": "1.77.0",
    "@sentry/node": "11.7.0",
    "clsx": "2.1.1",
    "hono": "4.13.13",
    "lucide-react": "1.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "3.0.68",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.1",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "postcss": "8.5.30",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "6.4.4"
  }
}
